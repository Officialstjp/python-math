# "Full notebooks" export profile — same rendering as the reference profile,
# but with all content included: exercises, text output, and glossary sections.
#
# Save this file as scripts/export_profile_full.toml to activate it, or
# pass it explicitly:
#     .\scripts\reexport_all.ps1 -FullContent
#
# This profile exports to exports_full/ to keep full-content builds separate
# from the compact reference builds under exports/.

[export_notebooks]
source_dir = "Foundations"
output_dir = "exports_full"
formats = ["html", "pdf", "markdown"]
workers = 8

[export_notebooks.filters]
# Include all content — no filtering.
exclude_glossary_formats = []
keep_glossary_notebooks = true
no_exercises = false
no_text_output = false

[export_notebooks.styles.html]
# Uncomment to tune exported HTML notebook pages.
# body_padding = "0 0.5rem"
# content_font_size = "10pt"
# content_line_height = "1.45"
# image_max_width = "900px"
# image_max_height = "70vh"
# image_margin = "0.5rem auto"

[export_notebooks.styles.pdf]
page_format = "A4"
content_font_size = "7.5pt"
content_font_size_small = "6.75pt"
code_font_size = "6pt"
content_line_height = "1.32"
heading_line_height = "1.2"
body_padding = "0 0.15in"
page_margin = "0.4in 0.2in"
table_font_size = "7.5pt"
table_cell_padding = "0.10rem 0.20rem"
image_max_width = "min(100%, 5.6in)"
image_max_height = "3.5in"
image_margin = "0.08in auto 0.12in"

[consolidate_htmls]
html_dir = "exports_full/Foundations/html"
output_dir = "exports_full/Foundations/html"
output_name = "Foundations_full.html"
title = "Mathematik Foundations (vollständig)"

[consolidate_htmls.filters]
exclude_chapters = []

[consolidate_htmls.layout]
sidebar_width = "280px"
content_max_width = "1000px"
content_padding = "2rem 3rem"
hide_sidebar_below = "900px"
body_font_family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
sidebar_background = "#1e1e2e"
sidebar_text = "#cdd6f4"
title_color = "#cba6f7"
accent = "#89b4fa"
divider = "#e0e0e0"
notebook_image_max_width = "100%"
notebook_image_max_height = "none"
section_break_after = "always"

[consolidate_pdfs]
pdf_dir = "exports_full/Foundations/pdf"
output_dir = "exports_full/Foundations/pdf"
output_name = "Foundations_full.pdf"
title = "Mathematik Foundations (vollständig)"
include_cover = true

[consolidate_pdfs.filters]
exclude_chapters = []

[consolidate_pdfs.metadata]
subject = "Mathematik Foundations"
creator = "Stefan Ploch"

[consolidate_pdfs.cover]
subtitle = "Vollständige Notebooks inkl. Übungsaufgaben und Lösungen"
footer_note = "Stefan Ploch, 2026"
